# Groww Weekly Pulse Multi-Agent System - Environment Variables
# Copy this file to .env and fill in your actual credentials

# Email Settings
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
RECIPIENT_EMAIL=recipient@example.com

# Groq API Keys (Get your keys from https://console.groq.com/keys)
GROQ_API_KEY_CLASSIFIER=your_groq_api_key_here
GROQ_API_KEY_STRATEGIST=your_groq_api_key_here
GROQ_API_KEY_FALLBACK=your_groq_api_key_here

# Play Store Settings (Optional - defaults provided)
GROWW_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.nextbillion.groww

# Date Filtering Settings (Optional - defaults provided)
CUTOFF_DAYS=60
